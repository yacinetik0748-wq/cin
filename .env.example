# GEMINI_API_KEY: Required for server-side Gemini AI translation calls.
# Users can also continue using the built-in External Gemini manual workflow without a key.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# FISH_API_KEY: Optional default Fish Audio API key (users can also save/encrypt keys inside Settings UI).
FISH_API_KEY=""

# SECRETS_ENCRYPTION_KEY: High-entropy secret string used to encrypt stored API keys in SQLite / D1 (AES-256-GCM).
SECRETS_ENCRYPTION_KEY=""

# STORAGE_ROOT: Local Express dev/node storage directory override (ignored on Cloudflare Pages).
STORAGE_ROOT=""

# MAX_UPLOAD_SIZE_MB: Max allowed source upload size in MB (default 1500).
MAX_UPLOAD_SIZE_MB="1500"

# TEMP_RETENTION_HOURS: Hours to keep temporary render artifacts during cleanup (default 24).
TEMP_RETENTION_HOURS="24"

# BACKEND_URL: Optional external Node.js Express server URL if you attach a heavy server-side FFmpeg worker.
# Leave unset to run 100% natively on Cloudflare Pages Functions + D1 + Browser FFmpeg WASM.
BACKEND_URL=""

# VITE_API_BASE_URL: Optional frontend override for API requests (leave blank for same-origin /api).
VITE_API_BASE_URL=""

# STORAGE_DIR: Local storage directory override (defaults to ./storage).
STORAGE_DIR=""

# FISH_API_BASE_URL: Optional Fish Audio API base URL override.
FISH_API_BASE_URL=""

# APP_SECRET: Fallback secret for key encryption if SECRETS_ENCRYPTION_KEY is unset.
APP_SECRET=""

